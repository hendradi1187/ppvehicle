# Device profile used when a request does not specify one: cpu | gpu
PPVEHICLE_PROFILE=cpu

# Where PaddleDetection is vendored (relative to project root)
PPVEHICLE_PADDLEDET=vendor/PaddleDetection

# Local model cache. Leave empty to let PaddleDetection download from bcebos
# into its own ~/.cache on first run.
PPVEHICLE_MODELS_DIR=models

# API
PPVEHICLE_HOST=127.0.0.1
PPVEHICLE_PORT=8000

# Max concurrent pipeline jobs (each one spawns a python subprocess)
PPVEHICLE_MAX_JOBS=1
