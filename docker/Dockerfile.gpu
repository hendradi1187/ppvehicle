# PP-Vehicle on a CUDA GPU server.
#
# This image runs `--run_mode paddle` on GPU out of the box. For
# `--run_mode trt_fp16` (the mode the README's 13-25ms timings assume) you need
# TensorRT inside the image — the least painful route is to swap the FROM line
# for PaddlePaddle's official TRT image, which already bundles a matching
# CUDA + cuDNN + TensorRT + paddle build, and drop the pip install of paddle:
#
#   FROM registry.baidubce.com/paddlepaddle/paddle:<version>-gpu-cuda<X>-cudnn<Y>-trt<Z>
#
# Check https://www.paddlepaddle.org.cn/en/install/quick for the current tag —
# they change with each release, so pin whatever you verify.

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PPVEHICLE_PROFILE=gpu \
    PPVEHICLE_MODELS_DIR=/models \
    FLAGS_enable_pir_api=0
# FLAGS_enable_pir_api=0 above: Paddle 3.x turns PIR on by default, and its
# Config(dir, prefix) form then looks for <prefix>.json. The official
# PP-Vehicle weights are still .pdmodel, so VEHICLE_ATTR fails to load with
# "Cannot open file model.json". PaddleDetection 2.9 predates PIR entirely.

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git ffmpeg \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Paddle GPU wheel first so it is cached independently of our code.
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python3 -m pip install --no-cache-dir paddlepaddle-gpu==3.3.1 \
        -i https://www.paddlepaddle.org.cn/packages/stable/cu126/

COPY requirements.txt ./
# paddlepaddle (CPU) is in requirements.txt for laptop dev; strip it here so it
# does not clobber the GPU wheel installed above.
RUN grep -v '^paddlepaddle==' requirements.txt > /tmp/req.txt && \
    python3 -m pip install --no-cache-dir -r /tmp/req.txt

# Vendored upstream is gitignored, so clone it at build time.
ARG PADDLEDET_BRANCH=release/2.9
RUN git clone --depth 1 --branch ${PADDLEDET_BRANCH} --single-branch \
        https://github.com/PaddlePaddle/PaddleDetection.git \
        /app/vendor/PaddleDetection

COPY pyproject.toml ./
COPY src ./src
COPY configs ./configs
RUN python3 -m pip install --no-cache-dir -e .

# Weights live on a mounted volume so the image stays small and a rebuild does
# not re-download 282 MB.
VOLUME ["/models", "/app/runs", "/app/data"]

EXPOSE 8000
CMD ["python3", "-m", "lalin", "serve", "--host", "0.0.0.0", "--port", "8000"]
