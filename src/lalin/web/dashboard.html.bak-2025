<title>Ruang Kendali Lalin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<style>
  :root {
    --ground: #eef2f4;
    --panel: #ffffff;
    --panel-2: #f6f9fa;
    --line: #d5e0e6;
    --line-soft: #e5edf1;
    --ink: #141e26;
    --ink-2: #3d525f;
    --muted: #64798a;
    --accent: #0c8184;
    --accent-soft: #d8efef;
    --crit: #c0372f;
    --crit-soft: #fae3e1;
    --warn: #a36a10;
    --warn-soft: #fbeed6;
    --ok: #1a7a5a;
    --ok-soft: #d9f0e6;
    --info: #2a6aa8;
    --info-soft: #dfecf8;
    --shadow: 0 1px 2px rgba(20, 30, 38, .06), 0 8px 24px rgba(20, 30, 38, .05);

    --display: "Barlow Condensed", "Arial Narrow", sans-serif;
    --body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #080c10;
      --panel: #10181f;
      --panel-2: #16212a;
      --line: #223240;
      --line-soft: #1a2831;
      --ink: #dde8ee;
      --ink-2: #a8bcc8;
      --muted: #748b9a;
      --accent: #2ec4c6;
      --accent-soft: #0e2f33;
      --crit: #f2685c;
      --crit-soft: #351a18;
      --warn: #e4a33e;
      --warn-soft: #33260f;
      --ok: #45c294;
      --ok-soft: #102e24;
      --info: #5d9ede;
      --info-soft: #132636;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .3);
    }
  }
  :root[data-theme="dark"] {
    --ground: #080c10;
    --panel: #10181f;
    --panel-2: #16212a;
    --line: #223240;
    --line-soft: #1a2831;
    --ink: #dde8ee;
    --ink-2: #a8bcc8;
    --muted: #748b9a;
    --accent: #2ec4c6;
    --accent-soft: #0e2f33;
    --crit: #f2685c;
    --crit-soft: #351a18;
    --warn: #e4a33e;
    --warn-soft: #33260f;
    --ok: #45c294;
    --ok-soft: #102e24;
    --info: #5d9ede;
    --info-soft: #132636;
    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .3);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--ground); color: var(--ink);
    font-family: var(--body); font-size: 14px; line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { margin: 0; font-family: var(--display); font-weight: 600;
               letter-spacing: .01em; text-wrap: balance; }
  .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }

  /* ---------------------------------------------------------- header */
  header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 30;
    background: var(--panel); border-bottom: 1px solid var(--line);
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 10px 16px;
  }
  .mark {
    display: flex; align-items: center; gap: 9px; margin-right: 2px;
  }
  .mark .glyph {
    width: 26px; height: 26px; border-radius: 5px; flex: none;
    background: var(--accent); color: var(--panel);
    display: grid; place-items: center;
    font-family: var(--display); font-weight: 700; font-size: 16px;
  }
  .mark h1 { font-size: 20px; line-height: 1; text-transform: uppercase;
             letter-spacing: .04em; }
  .mark .tag { display: block; font-family: var(--body); font-size: 10px;
               font-weight: 500; color: var(--muted); letter-spacing: .06em;
               text-transform: uppercase; margin-top: 2px; }
  .spacer { flex: 1 1 auto; }
  .chip {
    font-family: var(--mono); font-size: 11px; font-weight: 500;
    padding: 4px 9px; border-radius: 4px; border: 1px solid var(--line);
    color: var(--ink-2); background: var(--panel-2); white-space: nowrap;
  }
  .chip.proto { color: var(--warn); border-color: var(--warn);
                background: var(--warn-soft); font-weight: 600; }
  .chip.live { color: var(--ok); border-color: var(--ok); background: var(--ok-soft); }
  .chip.warn { color: var(--warn); border-color: var(--warn); background: var(--warn-soft); }
  /* Marks a region whose numbers are still illustrative. Deliberately small
     and always visible: a viewer must be able to tell real output from mockup
     without reading the header chip. */
  .demo-tag {
    font-family: var(--mono); font-size: 9.5px; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; color: var(--warn);
    border: 1px solid var(--warn); border-radius: 3px; padding: 1px 5px;
    margin-left: 7px; vertical-align: 2px; white-space: nowrap;
  }
  .chip.live::before {
    content: ""; display: inline-block; width: 6px; height: 6px;
    border-radius: 50%; background: var(--ok); margin-right: 6px;
    vertical-align: 1px; animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .chip.live::before { animation: none; } }
  button.icon {
    font-family: var(--body); font-size: 12px; font-weight: 500;
    padding: 5px 11px; border-radius: 5px; cursor: pointer;
    background: var(--panel-2); color: var(--ink-2); border: 1px solid var(--line);
  }
  button.icon:hover { color: var(--ink); border-color: var(--muted); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ----------------------------------------------------------- shell */
  .shell {
    display: grid; gap: 12px; padding: 12px 16px 24px;
    grid-template-columns: 224px minmax(0, 1fr) 330px;
    align-items: start; max-width: 1680px; margin: 0 auto;
  }
  @media (max-width: 1180px) { .shell { grid-template-columns: 200px minmax(0, 1fr); } }
  @media (max-width: 820px)  { .shell { grid-template-columns: minmax(0, 1fr); } }

  .panel {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 8px; box-shadow: var(--shadow);
  }
  .panel > .head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px; padding: 9px 12px; border-bottom: 1px solid var(--line-soft);
  }
  .panel > .head h2 {
    font-size: 12px; text-transform: uppercase; letter-spacing: .1em;
    color: var(--muted); font-weight: 600;
  }
  .count { font-family: var(--mono); font-size: 11px; color: var(--muted); }

  /* ------------------------------------------------------ camera rail */
  .cams { display: flex; flex-direction: column; max-height: 62vh; overflow: auto; }
  .cam {
    display: grid; grid-template-columns: 8px 1fr; gap: 9px; align-items: start;
    padding: 10px 12px; border: 0; border-bottom: 1px solid var(--line-soft);
    background: transparent; color: inherit; text-align: left; cursor: pointer;
    font: inherit; width: 100%;
  }
  .cam:hover { background: var(--panel-2); }
  .cam[aria-current="true"] { background: var(--accent-soft); }
  .cam .dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px;
              background: var(--ok); }
  .cam.alert .dot { background: var(--crit); }
  .cam .name { display: block; font-weight: 600; font-size: 13px; line-height: 1.25; }
  .cam .meta { display: block; font-family: var(--mono); font-size: 10.5px;
               color: var(--muted); margin-top: 3px; }
  .cam .owner { display: inline-block; font-size: 10px; font-weight: 600;
                letter-spacing: .05em; text-transform: uppercase;
                color: var(--info); margin-top: 4px; }
  .cam.alert .owner { color: var(--crit); }

  /* Kepala kelompok wilayah di rail kamera. */
  .wil {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: 9px 12px 6px; font-family: var(--display); font-size: 13px;
    font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--ink-2); background: var(--panel-2);
    border-bottom: 1px solid var(--line-soft);
  }
  .wil span { font-family: var(--mono); font-size: 11px; font-weight: 500;
              color: var(--muted); }
  .wil.kosong { color: var(--muted); }
  .wil.kosong span { color: var(--warn); }
  .wil-note {
    padding: 5px 12px 9px; font-size: 11px; line-height: 1.35;
    color: var(--muted); border-bottom: 1px solid var(--line-soft);
  }

  /* -------------------------------------------------------- live view */
  .stage { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .viewport {
    position: relative; background: #000; border-radius: 7px 7px 0 0;
    overflow: hidden; aspect-ratio: 16 / 9; max-width: 100%;
  }
  .viewport img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .viewport svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stamp {
    position: absolute; left: 10px; bottom: 10px; z-index: 2;
    font-family: var(--mono); font-size: 10px; color: #cfe3e8;
    background: rgba(4, 10, 14, .72); padding: 3px 7px; border-radius: 3px;
    letter-spacing: .02em;
  }
  .toolbar {
    display: flex; gap: 6px; flex-wrap: wrap; align-items: center;
    padding: 9px 12px; border-bottom: 1px solid var(--line-soft);
  }
  .toolbar .label { font-size: 11px; font-weight: 600; letter-spacing: .08em;
                    text-transform: uppercase; color: var(--muted); margin-right: 2px; }
  .seg {
    font-family: var(--body); font-size: 12px; font-weight: 500;
    padding: 4px 10px; border-radius: 99px; cursor: pointer;
    border: 1px solid var(--line); background: var(--panel-2); color: var(--ink-2);
  }
  .seg[aria-pressed="true"] {
    background: var(--accent); border-color: var(--accent); color: var(--panel);
  }
  .seg[disabled] { opacity: .45; cursor: not-allowed; }
  .grp { display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .hint {
    margin: 0; padding: 0 12px 10px; font-size: 11.5px; line-height: 1.45;
    color: var(--muted); border-bottom: 1px solid var(--line-soft);
  }
  .hint:empty { display: none; }
  .readout {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    gap: 1px; background: var(--line-soft);
  }
  .readout .cell { background: var(--panel); padding: 10px 12px; }
  .readout .k { font-size: 10.5px; font-weight: 600; letter-spacing: .07em;
                text-transform: uppercase; color: var(--muted); }
  .readout .v { font-family: var(--mono); font-size: 20px; font-weight: 600;
                margin-top: 2px; font-variant-numeric: tabular-nums; }
  .readout .v small { font-size: 11px; font-weight: 400; color: var(--muted); }

  /* Empat toolbox PP-Vehicle, satu baris per toolbox. */
  .tbx { display: grid; gap: 1px; background: var(--line-soft); }
  .tbx .row { background: var(--panel); padding: 10px 12px;
              display: grid; grid-template-columns: 22px 1fr auto; gap: 10px;
              align-items: baseline; }
  .tbx .no { font-family: var(--mono); font-size: 11px; font-weight: 600;
             color: var(--muted); }
  .tbx .nm { font-size: 13px; font-weight: 600; }
  .tbx .dt { grid-column: 2 / -1; font-size: 11.5px; color: var(--muted);
             margin-top: 3px; line-height: 1.45; }
  .tbx .dt b { color: var(--ink-2); font-weight: 600; }
  .tbx .st { font-family: var(--mono); font-size: 10px; font-weight: 600;
             letter-spacing: .06em; text-transform: uppercase;
             padding: 2px 7px; border-radius: 3px; border: 1px solid; white-space: nowrap; }
  .st.ok   { color: var(--ok);   border-color: var(--ok);   background: var(--ok-soft); }
  .st.bad  { color: var(--crit); border-color: var(--crit); background: var(--crit-soft); }
  .st.idle { color: var(--muted); border-color: var(--line); background: var(--panel-2); }

  /* ------------------------------------------------- source quality */
  .quality { padding: 12px; display: grid; gap: 10px; }
  .spec { font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); }
  .grade { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px;
           align-items: center; }
  .grade .task { font-size: 12.5px; }
  .bar { height: 5px; border-radius: 99px; background: var(--line-soft);
         grid-column: 1 / -1; overflow: hidden; margin-top: -4px; }
  .bar i { display: block; height: 100%; border-radius: 99px; }
  .verdict { font-size: 11px; font-weight: 600; letter-spacing: .04em;
             text-transform: uppercase; white-space: nowrap; }
  .ask {
    font-size: 12px; color: var(--ink-2); border-left: 2px solid var(--accent);
    padding: 2px 0 2px 10px; line-height: 1.5;
  }

  /* -------------------------------------------------------- event feed */
  .feed { display: flex; flex-direction: column; max-height: 58vh; overflow: auto; }
  .ev {
    display: grid; grid-template-columns: 3px 1fr; gap: 10px;
    border: 0; border-bottom: 1px solid var(--line-soft); background: transparent;
    color: inherit; font: inherit; text-align: left; cursor: pointer; width: 100%;
    padding: 0 12px 0 0;
  }
  .ev:hover { background: var(--panel-2); }
  .ev .stripe { background: var(--muted); }
  .ev.dishub .stripe { background: var(--crit); }
  .ev.rujuk  .stripe { background: var(--info); }
  .ev .body { padding: 10px 0; min-width: 0; }
  .ev .top { display: flex; align-items: baseline; gap: 8px; }
  .ev .kind { font-weight: 600; font-size: 13px; line-height: 1.25; flex: 1; }
  .ev .time { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .ev .where { display: block; font-size: 11.5px; color: var(--muted); margin-top: 2px;
               overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pills { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 7px; }
  .pill {
    font-size: 10px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 3px; border: 1px solid transparent;
  }
  .pill.act  { color: var(--crit); background: var(--crit-soft); border-color: var(--crit); }
  .pill.ref  { color: var(--info); background: var(--info-soft); border-color: var(--info); }
  .pill.conf { color: var(--ink-2); background: var(--panel-2); border-color: var(--line); }
  .pill.ver  { color: var(--ok);   background: var(--ok-soft);   border-color: var(--ok); }

  /* --------------------------------------------------------- kpi strip */
  .kpis {
    grid-column: 1 / -1; display: grid; gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }
  .kpi { padding: 12px 14px; }
  .kpi .k { font-size: 10.5px; font-weight: 600; letter-spacing: .07em;
            text-transform: uppercase; color: var(--muted); }
  .kpi .v { font-family: var(--mono); font-size: 28px; font-weight: 600;
            line-height: 1.1; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .kpi .sub { font-size: 11.5px; color: var(--muted); margin-top: 3px; }
  .kpi.klik { cursor: pointer; }
  .kpi.klik:hover, .kpi.klik:focus-visible { border-color: var(--accent); }
  .kpi .drill { font-size: 10.5px; color: var(--accent); margin-top: 7px;
                font-weight: 600; }
  .kpi .sub b { cursor: pointer; text-decoration: underline;
                text-decoration-style: dotted; text-underline-offset: 2px;
                font-weight: 600; color: var(--ink); }
  .filterchip { font-size: 11px; padding: 2px 8px; border-radius: 99px;
                border: 1px solid var(--accent); color: var(--accent);
                background: transparent; cursor: pointer; font-weight: 600; }
  .split { display: flex; gap: 3px; margin-top: 9px; height: 6px; }
  .split i { display: block; border-radius: 2px; }
  .chartcard { grid-column: span 2; padding: 12px 14px; min-width: 0; }
  @media (max-width: 620px) { .chartcard { grid-column: span 1; } }
  .chartcard svg { width: 100%; height: auto; display: block; margin-top: 6px; }

  /* ------------------------------------------------------------ modal */
  dialog {
    border: 1px solid var(--line); border-radius: 10px; padding: 0;
    background: var(--panel); color: var(--ink); max-width: 760px; width: calc(100% - 32px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, .35);
  }
  dialog::backdrop { background: rgba(4, 10, 14, .62); }
  .ev-head { display: flex; align-items: flex-start; gap: 12px;
             padding: 14px 16px; border-bottom: 1px solid var(--line-soft); }
  .ev-head h2 { font-size: 21px; }
  .ev-head .sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .ev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px; }
  @media (max-width: 680px) { .ev-grid { grid-template-columns: 1fr; } }
  .evidence { position: relative; border-radius: 6px; overflow: hidden;
              background: #000; aspect-ratio: 16 / 9; }
  .evidence img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .evidence svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  dl.facts { margin: 0; display: grid; grid-template-columns: auto 1fr;
             gap: 7px 14px; align-items: baseline; }
  dl.facts dt { font-size: 11px; font-weight: 600; letter-spacing: .05em;
                text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  dl.facts dd { margin: 0; font-size: 13px; }
  dl.facts dd.mono { font-size: 12px; }
  .legal { margin-top: 14px; padding: 10px 12px; border-radius: 6px;
           background: var(--panel-2); border: 1px solid var(--line-soft); }
  .legal .k { font-size: 10.5px; font-weight: 600; letter-spacing: .07em;
              text-transform: uppercase; color: var(--muted); }
  .legal .v { font-size: 12.5px; margin-top: 3px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap;
             padding: 0 16px 16px; }
  .actions button {
    font: inherit; font-size: 13px; font-weight: 600; padding: 8px 14px;
    border-radius: 6px; cursor: pointer; border: 1px solid var(--line);
    background: var(--panel-2); color: var(--ink-2);
  }
  .actions button.primary { background: var(--crit); border-color: var(--crit); color: #fff; }
  .actions button.ghost:hover { border-color: var(--muted); color: var(--ink); }
  .note { padding: 0 16px 16px; font-size: 11.5px; color: var(--muted); line-height: 1.5; }
  /* Penuntun langkah: satu lubang sorot di atas layar yang diredupkan.
     Dipakai box-shadow raksasa, bukan empat panel penutup - lebih sederhana
     dan lubangnya ikut membulat mengikuti elemen. */
  .tour-hole {
    position: fixed; z-index: 60; border-radius: 9px; pointer-events: none;
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 9999px rgba(4, 10, 14, .74);
    transition: all .22s ease;
  }
  .tour-card {
    position: fixed; z-index: 61; width: min(350px, calc(100vw - 32px));
    background: var(--panel); border: 1px solid var(--accent);
    border-radius: 9px; padding: 14px 16px 12px;
    box-shadow: 0 18px 46px rgba(0, 0, 0, .4);
  }
  .tour-card .no { font-family: var(--mono); font-size: 10.5px; font-weight: 600;
                   letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .tour-card h3 { font-size: 19px; margin: 3px 0 6px; }
  .tour-card p { margin: 0; font-size: 13px; line-height: 1.55; color: var(--ink-2); }
  .tour-nav { display: flex; gap: 7px; align-items: center; margin-top: 13px; }
  .tour-nav .sp { flex: 1 1 auto; }
  @media (prefers-reduced-motion: reduce) { .tour-hole { transition: none; } }

  .hh { font-size: 17px; margin: 22px 0 8px; color: var(--ink); }
  .hh:first-child { margin-top: 0; }
  .pp { font-size: 13px; line-height: 1.6; margin: 8px 0; color: var(--ink-2);
        max-width: 64ch; }
  #bantuan dl.facts { grid-template-columns: 148px 1fr; gap: 9px 14px; }
  #bantuan dl.facts dt { text-transform: none; letter-spacing: 0; font-size: 12.5px;
                         color: var(--ink); white-space: normal; }
  #bantuan dl.facts dd { font-size: 12.5px; line-height: 1.55; color: var(--ink-2); }
</style>

<header>
  <div class="mark">
    <span class="glyph" aria-hidden="true">RK</span>
    <div>
      <h1>Ruang Kendali Lalin</h1>
      <span class="tag">Analitik CCTV · Prototipe</span>
    </div>
  </div>
  <span class="chip proto" id="proto">Prototipe · tampilan contoh</span>
  <span class="chip" id="liveState">Menyambung…</span>
  <span class="chip">46 kamera publik</span>
  <span class="spacer"></span>
  <span class="chip mono" id="clock">—</span>
  <button class="icon" id="helpBtn" type="button">? Bantuan</button>
  <a class="icon" href="/zona" style="text-decoration:none;line-height:1.9">Editor Zona</a>
  <button class="icon" id="reanalyse" type="button">Analisis kamera ini</button>
  <button class="icon" id="theme" type="button">Mode gelap</button>
</header>

<div class="shell">

  <!-- ------------------------------------------------- camera rail -->
  <section class="panel">
    <div class="head">
      <h2>Kamera</h2>
      <span class="count" id="camCount">4 / 50</span>
    </div>
    <div class="cams" id="cams"></div>
  </section>

  <!-- --------------------------------------------------- live stage -->
  <div class="stage">
    <section class="panel" style="overflow:hidden">
      <div class="viewport">
        <img id="frame" alt="" >
        <svg id="overlay" viewBox="0 0 640 360" preserveAspectRatio="none" aria-hidden="true"></svg>
        <span class="stamp mono" id="stamp">—</span>
      </div>
      <div class="toolbar">
        <span class="grp" id="grpSumber">
          <span class="label">Sumber</span>
          <button class="seg" type="button" data-src="live" aria-pressed="true">Live</button>
          <button class="seg" type="button" data-src="analisis" aria-pressed="false">Analisis</button>
          <button class="seg" type="button" data-src="cuplikan" aria-pressed="false">Cuplikan</button>
        </span>
        <span class="grp" id="grpLapisan">
          <span class="label" style="margin-left:6px">Tampilkan</span>
          <button class="seg" type="button" data-layer="zone" aria-pressed="true">Zona</button>
          <button class="seg" type="button" data-layer="box" aria-pressed="true">Objek</button>
          <button class="seg" type="button" data-layer="track" aria-pressed="false">Lintasan</button>
          <button class="seg" type="button" data-layer="blur" aria-pressed="false">Samarkan pelat</button>
        </span>
      </div>
      <p class="hint" id="hint"></p>
      <div class="readout" id="readout"></div>
    </section>

    <section class="panel">
      <div class="head">
        <h2>Empat toolbox PP-Vehicle</h2>
        <span class="count" id="tbxZone">—</span>
      </div>
      <div class="tbx" id="toolbox"></div>
    </section>

    <section class="panel" id="panelKualitas">
      <div class="head">
        <h2>Kualitas sumber</h2>
        <span class="count" id="specStream">—</span>
      </div>
      <div class="quality">
        <p class="spec" id="spec">—</p>
        <div class="grade" id="grades"></div>
        <p class="ask" id="ask"></p>
      </div>
    </section>
  </div>

  <!-- --------------------------------------------------- event feed -->
  <section class="panel">
    <div class="head">
      <h2>Kejadian</h2>
      <button class="filterchip" id="filterChip" type="button" hidden></button>
      <span class="count"><span id="evCount">0</span> belum diverifikasi</span>
    </div>
    <div class="feed" id="feed"></div>
  </section>

  <!-- ---------------------------------------------------- kpi strip -->
  <div class="kpis">
    <section class="panel kpi klik" id="kpi1" role="button" tabindex="0"></section>
    <section class="panel kpi klik" id="kpi2" role="button" tabindex="0"></section>
    <section class="panel kpi klik" id="kpi3" role="button" tabindex="0"></section>
    <section class="panel chartcard">
      <div class="k" id="chartLabel" style="font-size:10.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)">
        Kejadian per jam
      </div>
      <svg id="chart" viewBox="0 0 320 84" role="img"
           aria-label="Kejadian per jam, puncak 24 kejadian pada pukul 17"></svg>
    </section>
  </div>
</div>

<dialog id="rincian">
  <div class="ev-head">
    <div style="flex:1;min-width:0">
      <h2>Kendaraan terpantau</h2>
      <div class="sub">Rincian per kamera · hari berjalan (WIB)</div>
    </div>
    <button class="icon" type="button" id="rClose">Tutup</button>
  </div>
  <div style="padding:14px 16px">
    <p style="margin:0 0 10px;font-size:12px;color:var(--muted);line-height:1.5">
      Dijumlah dari seluruh siklus hari ini (WIB). Angka pada kolom
      <strong>Track</strong> menjumlah hasil tiap siklus, jadi kendaraan yang
      sama pada dua siklus terhitung dua kali.
    </p>
    <div id="rBody"></div>
  </div>
</dialog>

<dialog id="bantuan">
  <div class="ev-head">
    <div style="flex:1;min-width:0">
      <h2>Panduan Operator</h2>
      <div class="sub">Ruang Kendali Lalin · analitik CCTV lalu lintas</div>
    </div>
    <button class="icon" type="button" id="tourBtn"
            style="background:var(--accent);border-color:var(--accent);color:var(--panel)">Jalankan penuntun</button>
    <button class="icon" type="button" id="helpClose">Tutup</button>
  </div>

  <div style="padding:16px;max-height:66vh;overflow:auto">

    <h3 class="hh">1 · Tiga sumber gambar</h3>
    <dl class="facts">
      <dt>Live</dt><dd>Frame kamera sungguhan, disegarkan tiap 3 detik.
        Kotak deteksi tidak ditampilkan — yang terlihat hanya kondisi jalan
        saat ini.</dd>
      <dt>Analisis</dt><dd>Hasil kerja sistem: frame dengan kotak kendaraan,
        zona, dan jejak lintasan yang digambar mesin. <strong>Inilah yang
        Anda periksa saat bertugas.</strong> Waktunya tertera di bawah gambar.</dd>
      <dt>Cuplikan</dt><dd>Gambar tersimpan. Dipakai bila jaringan ke server
        CCTV terputus, agar layar tidak kosong.</dd>
    </dl>
    <p class="pp">Mode Analisis tidak otomatis mengikuti waktu sekarang. Tekan
      <strong>Analisis kamera ini</strong> untuk memeriksa ulang kamera yang
      sedang dibuka — sekitar 40–60 detik.</p>

    <h3 class="hh">2 · Empat kemampuan yang dibaca sistem</h3>
    <dl class="facts">
      <dt>Pelat nomor</dt><dd>Membaca nomor kendaraan.
        <strong style="color:var(--crit)">Belum dapat diandalkan</strong> pada
        CCTV publik: resolusinya 640×360, pelat hanya selebar 8–15 piksel.
        Jangan dipakai sebagai dasar tindakan.</dd>
      <dt>Atribut kendaraan</dt><dd>Warna dan jenis bodi (sedan, truk, bus).
        Berguna untuk mencari kembali kendaraan pada rekaman.</dd>
      <dt>Hitung kendaraan</dt><dd>Jumlah kendaraan yang masuk zona yang Anda
        tentukan.</dd>
      <dt>Parkir liar</dt><dd>Kendaraan yang diam di zona melebihi ambang
        waktu. Ambangnya berbeda per lokasi — lihat butir 4.</dd>
    </dl>

    <h3 class="hh">3 · Batas kewenangan</h3>
    <p class="pp">Setiap kejadian diberi label kewenangan, dan itu bukan
      hiasan:</p>
    <dl class="facts">
      <dt><span class="pill act">Ranah Dishub</span></dt>
      <dd>Parkir liar, angkutan umum ngetem, angkutan barang di jam larangan.
        Penindakannya administratif — derek, cabut pentil, teguran.</dd>
      <dt><span class="pill ref">Rujuk Ditlantas</span></dt>
      <dd>Pelanggaran bergerak seperti okupansi lajur TransJakarta. Tilang
        adalah kewenangan Kepolisian; sistem hanya meneruskan berkasnya.</dd>
    </dl>

    <h3 class="hh">4 · Zona dan ambang waktu</h3>
    <p class="pp">Zona diatur lewat <strong>Editor Zona</strong> di kanan atas:
      klik titik di atas gambar, seret untuk menggeser, lalu
      <strong>Simpan &amp; analisis</strong>.</p>
    <p class="pp">Ambang parkir tidak boleh seragam. Di simpang padat kendaraan
      berhenti lama <em>karena lampu merah</em> — ambang 8 detik di sana akan
      menandai setiap mobil yang antre. Patokan yang dipakai sekarang:
      <strong>jalur sepeda dan bahu jalan 8 detik</strong> (tidak ada alasan
      sah berhenti), <strong>badan jalan simpang 120 detik</strong> (di atas
      satu siklus lampu merah).</p>

    <h3 class="hh">5 · Yang sistem ini tidak lakukan</h3>
    <p class="pp"><strong>Sistem tidak menetapkan pelanggaran.</strong> Setiap
      baris di daftar Kejadian adalah <em>usulan mesin</em> yang harus
      diverifikasi petugas sebelum ditindak. Mesin bisa keliru: pernah terjadi
      drum kabel oranye di trotoar terbaca sebagai kendaraan.</p>
    <p class="pp">Sistem juga tidak memantau terus-menerus. Ia memeriksa klip
      pendek secara berkala, jadi pelanggaran di antara dua pemeriksaan akan
      terlewat. Pemantauan penuh memerlukan server GPU.</p>

    <h3 class="hh">6 · Alur kerja harian</h3>
    <p class="pp">Buka Ruang Kendali → pilih kamera dari daftar wilayah →
      mode <strong>Analisis</strong> untuk melihat bacaan terakhir → periksa
      daftar <strong>Kejadian</strong> di kanan → klik satu kejadian untuk
      melihat kartu bukti beserta dasar hukumnya → putuskan: tindak, rujuk,
      atau tandai bukan pelanggaran.</p>
  </div>

  <p class="note">Ada yang janggal di layar? Catat nama kamera dan jamnya,
    lalu sampaikan ke tim teknis. Kekeliruan mesin adalah data yang berguna,
    bukan sesuatu yang perlu disembunyikan.</p>
</dialog>

<dialog id="detail">
  <div class="ev-head">
    <div style="flex:1;min-width:0">
      <h2 id="dKind">—</h2>
      <div class="sub" id="dWhere">—</div>
    </div>
    <button class="icon" type="button" id="dClose">Tutup</button>
  </div>
  <div class="ev-grid">
    <div>
      <div class="evidence">
        <img id="dImg" alt="">
        <svg id="dOverlay" viewBox="0 0 640 360" preserveAspectRatio="none" aria-hidden="true"></svg>
      </div>
      <div class="legal">
        <div class="k">Dasar hukum</div>
        <div class="v" id="dLegal">—</div>
      </div>
    </div>
    <div>
      <dl class="facts" id="dFacts"></dl>
    </div>
  </div>
  <div class="actions" id="dActions"></div>
  <p class="note">
    Setiap kejadian adalah <strong>usulan sistem</strong>, bukan penetapan pelanggaran.
    Penindakan baru berjalan setelah diverifikasi petugas. Pada purwarupa ini
    belum ada penghapusan otomatis maupun penyamaran permanen pada berkas
    tersimpan — tombol Samarkan pelat hanya berlaku pada tampilan layar.
  </p>
</dialog>

<script>
(() => {
  "use strict";

  // ---------------------------------------------------------------- data
  // Camera ids, names and stream specs are the real ones published on
  // jakcctv.jakarta.go.id (Flussonic, 640x360 @ 20fps). Boxes, zones and
  // events below are illustrative placeholders for the layout - they are
  // replaced by real PP-Vehicle output once the pipeline is wired in.
  // Lima kamera terpilih dari 46 kamera publik, dikelompokkan per wilayah DKI.
  // Pemilihannya berbasis ukuran objek, bukan selera: scripts/survey_cameras.py
  // menjalankan detector pada satu snapshot tiap kamera dan memberi skor =
  // jumlah kendaraan x luas bbox median. Skor itu dicantumkan di bawah supaya
  // pilihan ini bisa ditelusuri, bukan diperdebatkan.
  //
  // Jakarta Selatan kosong dan Utara/Timur tidak ada sama sekali di portal
  // publik. Itu ditampilkan apa adanya di rail kamera - celah cakupan justru
  // bahan permintaan ke Dishub, bukan sesuatu yang perlu ditutupi.
  const CAMS = [
    {
      key: "gerbangpemuda",
      id: "502160_JKP_POLDA_JL.-GERBANG-PEMUDA-C03_CCTV-02",
      name: "Jl. Gerbang Pemuda C03", area: "Senayan",
      region: "Jakarta Pusat", owner: "Polda",
      img: "cam/gerbangpemuda.jpg", scenario: "Hitung kendaraan",
      skor: 54.94, zone: null, boxes: []
    },
    {
      key: "thamrin",
      id: "502491_JKP_SATPOL-PP_SIMPANG-JL.-MH.-THAMRIN-C07_CCTV-02",
      name: "Simpang Jl. MH. Thamrin C07", area: "Menteng",
      region: "Jakarta Pusat", owner: "Satpol PP",
      img: "cam/thamrin.jpg", scenario: "Hitung kendaraan",
      skor: 14.25, zone: null, boxes: []
    },
    {
      key: "jatibaru",
      id: "503675_JKP_BAKESBANGPOL_JL.-JATI-BARU-RAYA-C02_CCTV-01",
      name: "Jl. Jati Baru Raya C02", area: "Tanah Abang",
      region: "Jakarta Pusat", owner: "Bakesbangpol",
      img: "cam/jatibaru.jpg", scenario: "Parkir liar", alert: true,
      skor: 13.39, boxes: []
    },
    {
      key: "sparman02",
      id: "502540_JKB_SATPOL-PP_SIMPANG-JL.-LETJEN.-S.-PARMAN-C02_CCTV-02",
      name: "Simpang Jl. S. Parman C02", area: "Grogol",
      region: "Jakarta Barat", owner: "Satpol PP",
      img: "cam/sparman02.jpg", scenario: "Hitung kendaraan",
      skor: 30.51, zone: null, boxes: []
    },
    {
      key: "sparman07",
      id: "502535_JKB_SATPOL-PP_SIMPANG-JL.-LETJEN.-S.-PARMAN-C07_CCTV-02",
      name: "Simpang Jl. S. Parman C07", area: "Grogol",
      region: "Jakarta Barat", owner: "Satpol PP",
      img: "cam/sparman07.jpg", scenario: "Hitung kendaraan",
      skor: 13.46, zone: null, boxes: []
    }
  ];

  // Wilayah tanpa kamera publik. Ditampilkan sebagai baris kosong di rail,
  // bukan disembunyikan.
  const WILAYAH_KOSONG = [
    { region: "Jakarta Selatan", note: "2 kamera publik, keduanya menghadap plaza" },
    { region: "Jakarta Utara", note: "tidak ada kamera di portal publik" },
    { region: "Jakarta Timur", note: "tidak ada kamera di portal publik" }
  ];

  // Tidak ada lagi kejadian contoh. Sebelumnya array ini berisi pelanggaran
  // karangan yang, setelah daftar kamera diganti, tertempel pada kamera NYATA
  // lengkap dengan jam yang spesifik - "Parkir di badan jalan, Jl. Gerbang
  // Pemuda C03, 12:15:04" untuk kejadian yang tidak pernah terjadi. Chip
  // "contoh" di header tidak cukup menebus itu. Feed sekarang hanya
  // menampilkan kejadian dari pipeline, dan kosong bila memang belum ada.
  const EVENTS = [];

  const GRADES = [
    { task: "Deteksi & hitung kendaraan", pct: 92, verdict: "Memadai",      tone: "ok" },
    { task: "Klasifikasi jenis kendaraan", pct: 68, verdict: "Cukup",        tone: "warn" },
    { task: "Deteksi diam / masuk zona",   pct: 88, verdict: "Memadai",      tone: "ok" },
    { task: "Baca pelat nomor",            pct: 14, verdict: "Tidak memadai", tone: "crit" }
  ];

  const HOURLY = [
    [6, 4], [7, 12], [8, 18], [9, 11], [10, 8], [11, 9], [12, 14],
    [13, 7], [14, 6], [15, 10], [16, 19], [17, 24], [18, 16]
  ];

  // ------------------------------------------------------------- helpers
  const $ = (id) => document.getElementById(id);
  const layers = { zone: true, box: true, track: false, blur: false };
  let active = 0;

  // ------------------------------------------------------------ live feed
  // Flussonic publishes a still per camera at <id>/preview.jpg. Polling it is
  // enough for an operator console and avoids shipping an HLS player.
  // It only works where the page may load that host: served from this app it
  // does, but a published artifact's CSP blocks it, so every failure falls
  // back to the snapshot bundled in cam/. That fallback is the whole reason
  // the bundled stills exist - a demo must not depend on the venue's wifi.
  const LIVE_BASE = "https://dki-jkt.balitower.co.id:7028/";
  const LIVE_EVERY_MS = 3000;
  // "live" = still from the camera, "analisis" = the pipeline's own annotated
  // frame from the last batch cycle, "cuplikan" = the snapshot bundled with
  // the page (works with no network at all).
  let srcMode = "live";
  let liveWorking = null;   // null = belum diketahui
  let liveTimer = null;
  let liveFails = 0;
  let batch = null;         // payload terakhir dari /api/batch
  let stats = null;         // payload terakhir dari /api/stats

  // Real figures only once at least one batch cycle has been recorded today;
  // before that the tiles keep their illustrative values, clearly tagged.
  const statsReal = () => !!(stats && stats.has_data);

  const camBatch = (cam) => (batch?.cameras || []).find((c) => c.key === cam.key);

  // Zona SELALU dibaca dari API, tidak pernah ditanam di berkas ini. Kalau
  // ditanam, menyimpan lewat editor /zona tidak akan mengubah apa pun di sini
  // - dan itu justru cacat yang paling membingungkan: backend berubah, layar
  // tidak.
  // Zona dianggap basi bila disimpan SETELAH analisis terakhir: frame yang
  // tampil masih membawa zona lama yang digambar pipeline saat siklus itu.
  function zonaBasi(cam) {
    const b = camBatch(cam);
    return !!(b?.zone_updated_at && b?.record?.finished_at
              && b.zone_updated_at > b.record.finished_at);
  }

  // Digambar dengan gaya berbeda dari zona biasa - garis tebal berkedip -
  // supaya tidak tertukar dengan zona lama yang terbakar di dalam gambar.
  function overlayZonaBaru(cam) {
    const z = zoneOf(cam);
    if (!z) return "";
    return `<polygon points="${z.pts}" fill="var(--ok)" fill-opacity=".12"
              stroke="var(--ok)" stroke-width="3" stroke-dasharray="10 6"/>
            <rect x="0" y="0" width="330" height="17" fill="var(--ok)"/>
            <text x="5" y="13" fill="#04231a" font-size="11" font-weight="700"
              font-family="IBM Plex Mono, monospace">ZONA BARU - BELUM DIANALISIS</text>`;
  }

  function zoneOf(cam) {
    const b = camBatch(cam);
    const rp = b?.region_polygon || [];
    if (rp.length < 6) return null;
    const pts = [];
    for (let i = 0; i + 1 < rp.length; i += 2) pts.push(`${rp[i]},${rp[i + 1]}`);
    return { pts: pts.join(" "), label: b.zone_label || "Zona" };
  }
  const hasAnalysis = (cam) => {
    const b = camBatch(cam);
    return !!(b && b.has_frame && b.record && b.record.ok);
  };

  // "Live" only counts once a frame has actually arrived. Until then, and
  // after a failure, the page behaves exactly as it does in snapshot mode.
  const liveActive = () => srcMode === "live" && liveWorking === true;

  // What is still illustrative right now. The header chip must describe the
  // actual mix on screen, not just the viewport mode: even with a real analysed
  // frame, the daily recap below is still a mockup.
  function demoParts() {
    const parts = [];
    // Gambar kamera tidak pernah karangan lagi: mode live menarik frame
    // sungguhan, mode cuplikan memakai snapshot asli, mode analisis memakai
    // keluaran pipeline. Angka kamera pun kini kosong bila belum dianalisis,
    // bukan diisi contoh. Yang tersisa hanya dua hal di bawah.
    // Daftar kejadian tidak lagi punya versi contoh, jadi tidak ada yang
    // perlu disebut di sini soal itu.
    if (!statsReal()) parts.push("rekap harian");
    return parts;
  }

  function updateProtoChip() {
    const parts = demoParts();
    const el = $("proto");
    if (parts.length) {
      el.className = "chip proto";
      el.textContent = "Contoh: " + parts.join(" · ");
      el.title = "Bagian yang disebut di sini masih tampilan contoh, bukan "
               + "keluaran model. Penanda kuning menandai tiap bagiannya.";
    } else {
      el.className = "chip live";
      el.textContent = "Seluruhnya keluaran pipeline";
      el.title = "Tidak ada data contoh yang sedang tampil.";
    }
  }

  function setLiveChip() {
    const el = $("liveState");
    if (srcMode === "analisis") {
      el.className = "chip live"; el.textContent = "Hasil analisis pipeline"; return;
    }
    if (srcMode === "cuplikan") {
      el.className = "chip"; el.textContent = "Cuplikan tersimpan"; return;
    }
    if (liveWorking === true) {
      el.className = "chip live";
      el.textContent = `Live · segar tiap ${LIVE_EVERY_MS / 1000} dtk`;
    } else if (liveWorking === false) {
      el.className = "chip warn";
      el.textContent = "Live tak terjangkau · pakai cuplikan";
    } else {
      el.className = "chip";
      el.textContent = "Menyambung…";
    }
  }

  // Hand-placed boxes describe the bundled snapshot, not whatever the camera
  // is looking at right now. Showing them over a live frame would be a lie,
  // so live mode hides them. The zone polygon stays: the camera is fixed, so
  // the polygon is just as true on a live frame as on the snapshot.
  function applyLiveConstraints() {
    // Kotak nyata hanya ada pada mode Analisis; pada Cuplikan yang tampil
    // adalah kotak ilustrasi. Mode Live tidak punya keduanya.
    const boxBtn = document.querySelector('[data-layer="box"]');
    const adaKotak = srcMode === "cuplikan"
                  || (srcMode === "analisis" && hasAnalysis(CAMS[active])
                      && (camBatch(CAMS[active])?.record?.results?.boxes || []).length > 0);
    boxBtn.disabled = !adaKotak;
    boxBtn.setAttribute("aria-pressed", String(adaKotak && layers.box));
    const cam = CAMS[active];
    let hint = "";
    if (srcMode === "live") {
      hint = "Frame kamera sungguhan, disegarkan tiap 3 detik. Kotak deteksi "
           + "disembunyikan karena overlay contoh tidak cocok dengan frame nyata. "
           + "Poligon zona tetap berlaku (kamera statis).";
    } else if (srcMode === "analisis") {
      const b = camBatch(cam);
      const zonaBaru = b?.zone_updated_at && b?.record?.finished_at
        && b.zone_updated_at > b.record.finished_at;
      hint = hasAnalysis(cam)
        ? (zonaBaru
            ? "⚠ Zona diubah SETELAH analisis terakhir. Poligon di layar sudah "
              + "yang baru, tetapi angka dan temuan di bawah masih dihitung "
              + "dengan zona lama. Klik “Analisis ulang” agar keduanya sejalan."
            : "Kotak, jejak, dan zona digambar dari keluaran PP-Vehicle — "
              + "kendaraan biasa berkotak tipis, yang melanggar bergaris merah "
              + "tebal beserta lama diamnya. Pakai tombol Tampilkan untuk "
              + "menyalakan atau mematikan tiap lapisan.")
        : "Kamera ini belum punya hasil analisis. Jalankan siklus batch "
          + "(tombol Analisis ulang) lalu tunggu — satu kamera makan ±1 menit di CPU.";
    } else {
      hint = "Cuplikan tersimpan dengan overlay ilustrasi — untuk demo tanpa "
           + "jaringan. Kotak di sini bukan keluaran model.";
    }
    $("hint").textContent = hint;
  }

  function pullLive() {
    if (srcMode !== "live") return;
    const cam = CAMS[active];
    const probe = new Image();
    probe.onload = () => {
      if (srcMode !== "live" || CAMS[active] !== cam) return;   // pengguna sudah pindah
      const first = liveWorking !== true;
      $("frame").src = probe.src;
      liveWorking = true;
      liveFails = 0;
      setLiveChip();
      if (first) { applyLiveConstraints(); $("overlay").innerHTML = overlaySvg(cam); }
      updateProtoChip();
      const jam = new Date().toLocaleTimeString("id-ID", { hour12: false });
      $("stamp").textContent = `${cam.id.slice(0, 6)} · ${cam.name} · 640×360 · ${jam}`;
    };
    probe.onerror = () => {
      if (srcMode !== "live") return;
      liveWorking = false;
      setLiveChip();
      applyLiveConstraints();
      $("overlay").innerHTML = overlaySvg(CAMS[active]);
      updateProtoChip();
      // A blocked host (a published artifact's CSP does exactly this) will
      // never recover, so stop hammering it after a couple of tries.
      if (++liveFails >= 2) clearInterval(liveTimer);
    };
    probe.src = `${LIVE_BASE}${cam.id}/preview.jpg?t=${Date.now()}`;
  }

  function startLive() {
    clearInterval(liveTimer);
    if (srcMode !== "live") return;
    pullLive();
    liveTimer = setInterval(pullLive, LIVE_EVERY_MS);
  }

  const esc = (s) => String(s).replace(/[&<>"]/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

  async function api(path, opts) {
    const res = await fetch(path, opts);
    if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
    return res.json();
  }

  // --------------------------------------------------------- rendering
  function overlaySvg(cam, only, forceBoxes) {
    // Illustrative boxes only make sense over the snapshot they were drawn for.
    const showBoxes = forceBoxes || (layers.box && srcMode === "cuplikan");
    const parts = [];
    const zona = zoneOf(cam);
    if (layers.zone && zona) {
      parts.push(
        `<polygon points="${zona.pts}" fill="var(--crit)" fill-opacity=".14"` +
        ` stroke="var(--crit)" stroke-width="2" stroke-dasharray="7 5"/>`,
        `<text x="${zona.pts.split(" ")[0].split(",")[0]}" y="14"` +
        ` fill="var(--crit)" font-family="IBM Plex Mono, monospace" font-size="11"` +
        ` font-weight="600">${esc(zona.label.toUpperCase())}</text>`
      );
    }
    if (showBoxes) {
      for (const b of cam.boxes) {
        if (only != null && b.id !== only) continue;
        const stroke = b.bad ? "var(--crit)" : "var(--accent)";
        const label = `#${b.id} ${b.cls} ${Math.round(b.conf * 100)}%`;
        const w = label.length * 5.6 + 10;
        parts.push(
          `<rect x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}" fill="none"` +
          ` stroke="${stroke}" stroke-width="2" rx="2"/>`,
          `<rect x="${b.x}" y="${Math.max(0, b.y - 15)}" width="${w}" height="15"` +
          ` fill="${stroke}" rx="2"/>`,
          `<text x="${b.x + 5}" y="${Math.max(0, b.y - 15) + 11}" fill="#06131a"` +
          ` font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600">` +
          `${esc(label)}</text>`
        );
        if (layers.track && !b.bad) {
          parts.push(
            `<path d="M${b.x + b.w / 2},${b.y + b.h} q -30,-40 -64,-58" fill="none"` +
            ` stroke="var(--accent)" stroke-width="2" stroke-opacity=".55"` +
            ` stroke-dasharray="4 4"/>`
          );
        }
        if (layers.blur) {
          parts.push(
            `<rect x="${b.x + b.w * .34}" y="${b.y + b.h * .74}"` +
            ` width="${b.w * .32}" height="${Math.max(5, b.h * .12)}"` +
            ` fill="var(--ink-2)" fill-opacity=".92" rx="1"/>`
          );
        }
      }
    }
    return parts.join("");
  }

  // Lapisan untuk mode Analisis, digambar dari angka di results.json.
  //
  // Sebelumnya mode ini menampilkan frame terakhir video beranotasi pipeline.
  // PaddleDetection menggambar warna, jenis, skor, dan penghitung ke setiap
  // kendaraan dengan ukuran huruf tetap; pada 640x360 dengan 30-an kendaraan
  // hasilnya saling menimpa sampai tidak terbaca. Angkanya sama, yang berubah
  // hanya berapa banyak yang ditulis ke layar:
  //   - kendaraan biasa  -> kotak tipis, tanpa teks
  //   - yang melanggar   -> kotak tebal merah + satu label berisi lama diamnya
  // Ringkasan jumlah ditaruh sekali di pojok, bukan diulang per kendaraan.
  function overlayAnalisis(cam) {
    const rec = camBatch(cam)?.record;
    const r = rec?.results || {};
    const boxes = r.boxes || [];
    const parts = [];

    const zona = zoneOf(cam);
    if (layers.zone && zona) {
      parts.push(
        `<polygon points="${zona.pts}" fill="var(--crit)" fill-opacity=".12"` +
        ` stroke="var(--crit)" stroke-width="2" stroke-dasharray="7 5"/>`);
    }

    // track_id -> lama diam, supaya label pelanggar menyebut angka yang sama
    // dengan yang tampil di daftar Kejadian.
    const lama = {};
    for (const e of r.events || []) lama[e.track_id] = e.duration_sec;

    if (layers.track) {
      for (const t of r.trails || []) {
        if ((t.pts || []).length < 4) continue;
        const d = t.pts.map((p, i) => `${i ? "L" : "M"}${p[0]},${p[1]}`).join("");
        const bad = t.id in lama;
        parts.push(
          `<path d="${d}" fill="none" stroke="${bad ? "var(--crit)" : "var(--accent)"}"` +
          ` stroke-width="${bad ? 2 : 1.2}" stroke-opacity="${bad ? ".85" : ".4"}"` +
          ` stroke-linejoin="round"/>`);
      }
    }

    if (layers.box) {
      for (const b of boxes) {
        if (b.bad || b.id in lama) continue;
        parts.push(
          `<rect x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}"` +
          ` fill="none" stroke="var(--accent)" stroke-width="1.8"` +
          ` stroke-opacity=".9" rx="2"/>`);
      }
      if (layers.blur) {
        for (const b of boxes) {
          parts.push(
            `<rect x="${b.x + b.w * .3}" y="${b.y + b.h * .72}"` +
            ` width="${b.w * .4}" height="${Math.max(4, b.h * .14)}"` +
            ` fill="var(--ink-2)" fill-opacity=".92" rx="1"/>`);
        }
      }
      // Pelanggar digambar paling akhir supaya tidak tertutup kotak tetangganya.
      for (const b of boxes) {
        if (!(b.bad || b.id in lama)) continue;
        const teks = lama[b.id] != null
          ? `#${b.id} · diam ${lama[b.id]} dtk` : `#${b.id} · pelanggaran`;
        const w = teks.length * 5.6 + 12;
        const ly = b.y > 18 ? b.y - 16 : b.y + b.h + 2;
        parts.push(
          `<rect x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}"` +
          ` fill="var(--crit)" fill-opacity=".1" stroke="var(--crit)"` +
          ` stroke-width="2.5" rx="2"/>`,
          `<rect x="${b.x}" y="${ly}" width="${w}" height="15" fill="var(--crit)" rx="2"/>`,
          `<text x="${b.x + 6}" y="${ly + 11}" fill="#fff" font-weight="700"` +
          ` font-family="IBM Plex Mono, monospace" font-size="10">${esc(teks)}</text>`);
      }
    }

    // Satu ringkasan di pojok menggantikan deretan penghitung yang dulu
    // ditumpuk pipeline di sepanjang sisi atas gambar.
    const nPelanggar = (r.events || []).length;
    const ring = `${r.unique_tracks ?? boxes.length} kendaraan terlacak`
               + ` · ${boxes.length} di frame ini · ${nPelanggar} pelanggaran`;
    parts.unshift(
      `<rect x="0" y="0" width="${ring.length * 5.4 + 14}" height="17"` +
      ` fill="#000" fill-opacity=".62"/>`,
      `<text x="6" y="12.5" fill="#fff" font-family="IBM Plex Mono, monospace"` +
      ` font-size="10" font-weight="600">${esc(ring)}</text>`);

    if (zona && layers.zone) {
      // Menempel pada titik tertinggi poligon, bukan pada sudut gambar: label
      // ikut berpindah kalau operator menggeser zona, dan tidak menabrak
      // keterangan frame di kiri bawah.
      const tp = zona.pts.split(" ").map((p) => p.split(",").map(Number))
                     .reduce((a, p) => (p[1] < a[1] ? p : a));
      const teks = `ZONA: ${zona.label.toUpperCase()}`;
      const lw = teks.length * 5.4 + 12;
      const lx = Math.min(Math.max(0, tp[0] - lw / 2), 640 - lw);
      const ly = tp[1] > 36 ? tp[1] - 20 : tp[1] + 4;
      parts.push(
        `<rect x="${lx}" y="${ly}" width="${lw}" height="16" fill="#000"` +
        ` fill-opacity=".66" rx="2"/>`,
        `<text x="${lx + 6}" y="${ly + 11.5}" fill="#ff9d90" font-weight="700"` +
        ` font-family="IBM Plex Mono, monospace" font-size="10">${esc(teks)}</text>`);
    }
    return parts.join("");
  }

  function renderCams() {
    const urut = ["Jakarta Pusat", "Jakarta Barat"];
    let html = "";
    for (const wil of urut) {
      const anggota = CAMS.map((c, i) => ({ c, i })).filter((x) => x.c.region === wil);
      if (!anggota.length) continue;
      html += `<div class="wil">${esc(wil)}<span>${anggota.length}</span></div>`;
      html += anggota.map(({ c, i }) => `
        <button class="cam${c.alert ? " alert" : ""}" type="button"
                aria-current="${i === active}" data-i="${i}">
          <span class="dot" aria-hidden="true"></span>
          <span>
            <span class="name">${esc(c.name)}</span>
            <span class="meta">${esc(c.area)} · skor ${c.skor}</span>
            <span class="owner">${esc(c.owner)}${c.alert ? " · perlu tindakan" : ""}</span>
          </span>
        </button>`).join("");
    }
    // Wilayah tanpa kamera ditampilkan, tidak disembunyikan: celah cakupan
    // adalah informasi, dan menyembunyikannya membuat portal publik terlihat
    // lebih lengkap daripada kenyataannya.
    html += WILAYAH_KOSONG.map((w) => `
      <div class="wil kosong">${esc(w.region)}<span>0</span></div>
      <div class="wil-note">${esc(w.note)}</div>`).join("");
    $("cams").innerHTML = html;
    $("camCount").textContent = `${CAMS.length} / 46`;
  }

  function renderStage() {
    const c = CAMS[active];
    const b = camBatch(c);

    if (srcMode === "analisis" && hasAnalysis(c)) {
      // Frame-nya bersih; kotak, jejak, dan zona digambar di sini dari angka
      // yang ditangkap pipeline, supaya kepadatan labelnya terkendali.
      //
      // Siklus yang berjalan sebelum penangkapan koordinat ditambahkan tidak
      // punya daftar kotak. Untuk rekaman itu gambar beranotasi pipeline tetap
      // dipakai - padat, tetapi jujur - daripada menampilkan frame bersih yang
      // seolah-olah tidak ada kendaraan terdeteksi sama sekali.
      const adaKoordinat = (camBatch(c)?.record?.results?.boxes || []).length > 0;
      $("frame").src = `/api/batch/frame/${encodeURIComponent(c.key)}`
        + `?${adaKoordinat ? "" : "annotated=1&"}t=${Date.now()}`;
      $("overlay").innerHTML = (adaKoordinat ? overlayAnalisis(c) : "")
        + (zonaBasi(c) ? overlayZonaBaru(c) : "");
      $("stamp").textContent =
        `${c.name} · analisis ${jamWIB(b.record.finished_at)} WIB · `
        + `${b.record.results?.frames ?? "?"} frame`;
    } else {
      // Paint the bundled snapshot first so the panel is never blank, then let
      // the live poll swap it in if the host is reachable.
      $("frame").src = c.img;
      $("overlay").innerHTML = overlaySvg(c);
      $("stamp").textContent = `${c.id.slice(0, 6)} · ${c.name} · 640×360 20fps`;
    }
    $("frame").alt = `Kamera ${c.name}`;

    const r = b && b.record && b.record.ok ? b.record : null;
    const cells = (srcMode === "analisis" && r)
      ? [["Track unik", String(r.results?.unique_tracks ?? 0)],
         ["Frame dianalisis", String(r.results?.frames ?? 0)],
         ["Kejadian", String((r.results?.events || []).length)],
         ["Waktu proses", `${r.elapsed_sec ?? "?"} dtk`]]
      // Tidak ada angka cadangan yang dikarang. Sebelum dianalisis, sel
      // ditampilkan kosong - itu jujur, dan "belum ada data" adalah keadaan
      // yang sah untuk ditunjukkan.
      : [["Track unik", "—"], ["Frame dianalisis", "—"],
         ["Kejadian", "—"], ["Waktu proses", "—"]];
    $("readout").innerHTML = cells.map(([k, v]) =>
      `<div class="cell"><div class="k">${esc(k)}</div>` +
      `<div class="v">${esc(v)}</div></div>`
    ).join("");
    updateProtoChip();
    $("specStream").textContent = c.scenario;
    $("spec").textContent =
      "index.fmp4.m3u8 · H.264 Main · 640×360 · 20 fps · 534 kbps · Flussonic";
    document.querySelectorAll(".cam").forEach((el, i) =>
      el.setAttribute("aria-current", String(i === active)));
    applyLiveConstraints();
    startLive();
    renderToolbox();
  }

  function renderGrades() {
    $("grades").innerHTML = GRADES.map((g) => `
      <span class="task">${esc(g.task)}</span>
      <span class="verdict" style="color:var(--${g.tone})">${esc(g.verdict)}</span>
      <span class="bar"><i style="width:${g.pct}%;background:var(--${g.tone})"></i></span>
    `).join("");
    $("ask").innerHTML =
      "Pada feed publik 640×360, pelat nomor hanya selebar 8–15 piksel — di bawah " +
      "ambang baca OCR (±100 piksel). <strong>Identifikasi pelat memerlukan akses " +
      "feed sumber Dishub (≥1080p)</strong>; seluruh fungsi lain sudah berjalan " +
      "pada feed publik.";
  }

  // Stempel waktu di kartu bukti harus benar dan harus WIB. Server menyimpan
  // UTC; menampilkan jam UTC dengan label "WIB" membuat bukti meleset 7 jam -
  // pada berkas yang mungkin dipakai untuk penindakan, itu fatal.
  const WIB = { timeZone: "Asia/Jakarta" };
  const jamWIB = (iso) => {
    if (!iso) return "—";
    const d = new Date(iso);
    return isNaN(d) ? "—" : d.toLocaleTimeString("id-ID", { ...WIB, hour12: false });
  };
  const tanggalJamWIB = (iso) => {
    if (!iso) return "—";
    const d = new Date(iso);
    return isNaN(d) ? "—" : d.toLocaleString("id-ID", {
      ...WIB, day: "numeric", month: "short", year: "numeric",
      hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
    }) + " WIB";
  };

  const PARKIR_LEGAL =
    "Perda DKI Jakarta No. 5 Tahun 2012 tentang Perparkiran — penertiban dan "
    + "penderekan kendaraan yang parkir di badan jalan.";

  // Sumbernya basis data, bukan results.json pemeriksaan terakhir. Temuan
  // harus tetap ada setelah kameranya diperiksa ulang - kalau tidak, kartu KPI
  // dan daftar ini akan berselisih, dan petugas kehilangan temuan yang belum
  // sempat ditindak hanya karena siklus berikutnya berjalan.
  function dbEvents() {
    return EVDB.map((r) => ({
      real: true,
      id: r.id,
      cycleId: r.cycle_id,
      t: jamWIB(r.detected_at),
      iso: r.detected_at,
      cam: CAMS.findIndex((c) => c.key === r.camera),
      camKey: r.camera,
      kind: r.label || "Pelanggaran",
      wewenang: r.authority === "dishub" ? "dishub" : "rujuk",
      conf: null,
      verified: !!r.verified,
      verdict: r.verdict,
      kendaraan: `Objek terlacak #${r.track_id}`,
      durasi: `${r.duration_sec} dtk diam (ambang ${r.threshold_sec} dtk)`,
      plat: null,
      legal: PARKIR_LEGAL,
    }));
  }

  // Kamera bisa saja sudah dicabut dari daftar sejak temuannya tercatat.
  // Menjatuhkan temuannya akan menyembunyikan pekerjaan yang belum selesai,
  // jadi tampilkan apa adanya dengan keterangan.
  function camOf(e) {
    return CAMS[e.cam] || {
      key: e.camKey, id: e.camKey, name: e.camKey,
      area: "kamera tidak lagi terdaftar", owner: "\u2014",
      img: "", boxes: [], region: "",
    };
  }

  const TAG_DEMO = '<span class="demo-tag">contoh</span>';
  let FEED = EVENTS;
  let EVDB = [];            // /api/events - seluruh temuan hari ini
  let feedFilter = null;    // null | "dishub" | "rujuk" | "belum" | "sudah"

  const FILTER_LABEL = {
    dishub: "Ranah Dishub", rujuk: "Rujuk Ditlantas",
    belum: "Belum diverifikasi", sudah: "Sudah diverifikasi",
  };

  // Menekan saringan yang sedang aktif akan mematikannya - chip di kepala
  // panel memakai jalur yang sama, jadi hanya ada satu cara membersihkannya.
  function setFilter(f) {
    feedFilter = feedFilter === f ? null : f;
    renderFeed();
    document.querySelector("#feed").closest(".panel")
      .scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  function renderFeed() {
    const semua = dbEvents();
    const tersaring = semua.filter((e) =>
      feedFilter === null ? true
      : feedFilter === "belum" ? !e.verified
      : feedFilter === "sudah" ? e.verified
      : e.wewenang === feedFilter);
    FEED = semua.length ? tersaring : EVENTS;

    const chip = $("filterChip");
    chip.hidden = !feedFilter;
    if (feedFilter) chip.textContent = FILTER_LABEL[feedFilter] + " \u00d7";

    const head = document.querySelector("#feed").previousElementSibling;
    head.querySelector("h2").textContent = "Kejadian";
    if (!FEED.length) {
      $("feed").innerHTML =
        '<p style="padding:16px 12px;margin:0;font-size:12.5px;color:var(--muted);' +
        'line-height:1.5">' + (semua.length
          ? "Tidak ada temuan yang cocok dengan saringan “"
            + esc(FILTER_LABEL[feedFilter]) + "”. Tekan chip di atas untuk "
            + "menampilkan seluruhnya."
          : "Belum ada pelanggaran terdeteksi hari ini. Baris di sini hanya "
            + "terisi oleh keluaran pipeline — tidak ada contoh yang "
            + "ditampilkan.") + '</p>';
      $("evCount").textContent = String(semua.filter((e) => !e.verified).length);
      updateProtoChip();
      return;
    }
    $("feed").innerHTML = FEED.map((e, i) => {
      const cam = camOf(e);
      return `
        <button class="ev ${e.wewenang}" type="button" data-e="${i}">
          <span class="stripe" aria-hidden="true"></span>
          <span class="body">
            <span class="top">
              <span class="kind">${esc(e.kind)}</span>
              <span class="time">${esc(e.t)}</span>
            </span>
            <span class="where">${esc(cam.name)} · ${esc(cam.area)}</span>
            <span class="pills">
              <span class="pill ${e.wewenang === "dishub" ? "act" : "ref"}">
                ${e.wewenang === "dishub" ? "Ranah Dishub" : "Rujuk Ditlantas"}</span>
              ${e.conf != null
                ? `<span class="pill conf">Keyakinan ${Math.round(e.conf * 100)}%</span>`
                : '<span class="pill conf">Dari pipeline</span>'}
              ${e.verified ? '<span class="pill ver">Terverifikasi</span>' : ""}
            </span>
          </span>
        </button>`;
    }).join("");
    $("evCount").textContent = String(semua.filter((e) => !e.verified).length);
    updateProtoChip();
  }

  function renderKpi() {
    const real = statsReal();
    const tag = real ? "" : " " + TAG_DEMO;
    const d = real ? stats : {
      events_today: 148, by_authority: { dishub: 112, rujuk: 36 },
      verified: 86, unverified: 62, vehicles_tracked: 24318, cycles_today: 0,
    };
    const nf = (n) => n.toLocaleString("id-ID");
    const dis = d.by_authority.dishub, ruj = d.by_authority.rujuk;

    $("kpi1").innerHTML =
      `<div class="k">Kejadian hari ini${tag}</div>` +
      `<div class="v">${nf(d.events_today)}</div>` +
      `<div class="sub"><b data-drill="dishub">${nf(dis)} ranah Dishub</b> · ` +
      `<b data-drill="rujuk">${nf(ruj)} dirujuk</b></div>` +
      `<div class="split" aria-hidden="true">` +
      `<i style="flex:${dis || 0};background:var(--crit)"></i>` +
      `<i style="flex:${ruj || 0};background:var(--info)"></i>` +
      `<i style="flex:${(dis + ruj) ? 0 : 1};background:var(--line)"></i></div>` +
      `<div class="drill">Klik untuk melihat daftarnya ↓</div>`;

    $("kpi2").innerHTML =
      `<div class="k">Diverifikasi petugas${tag}</div>` +
      `<div class="v">${nf(d.verified)} <small>/ ${nf(d.events_today)}</small></div>` +
      `<div class="sub">${nf(d.unverified)} menunggu antrean verifikasi</div>` +
      `<div class="split" aria-hidden="true">` +
      `<i style="flex:${d.verified || 0};background:var(--ok)"></i>` +
      `<i style="flex:${d.unverified || 0};background:var(--line)"></i>` +
      `<i style="flex:${d.events_today ? 0 : 1};background:var(--line)"></i></div>` +
      `<div class="drill">Klik untuk melihat antrean verifikasi ↓</div>`;

    $("kpi3").innerHTML =
      `<div class="k">Kendaraan terpantau${tag}</div>` +
      `<div class="v">${nf(d.vehicles_tracked)}</div>` +
      `<div class="sub">${real
        ? `${nf(d.cycles_today)} siklus analisis hari ini (WIB)`
        : "4 kamera aktif · sejak 06.00"}</div>` +
      `<div class="drill">Klik untuk rincian per kamera →</div>`;

    $("chartLabel").innerHTML = "Kejadian per jam" + tag;
  }

  // Pelat Indonesia: 1-2 huruf wilayah, 1-4 angka, 0-3 huruf akhir.
  // Dipakai untuk memisahkan pembacaan yang masuk akal dari sampah OCR -
  // supaya klaim "tidak terbaca" bisa diuji, bukan sekadar pendapat.
  const PLAT_ID = /^[A-Z]{1,2}\s?\d{1,4}\s?[A-Z]{0,3}$/;

  function renderToolbox() {
    const cam = CAMS[active];
    const b = camBatch(cam);
    const r = (b && b.record && b.record.ok) ? (b.record.results || {}) : null;
    $("tbxZone").textContent = b && b.zone_label
      ? `zona: ${b.zone_label}` : "—";

    const baris = [];

    // 1. Pelat nomor
    const plat = (r?.plates || []);
    const sah = plat.filter((x) => PLAT_ID.test(x.text.toUpperCase()));
    baris.push({
      no: "1", nama: "Pengenalan pelat nomor",
      st: !r ? ["idle", "belum"] : sah.length ? ["ok", "terbaca"] : ["bad", "tidak memadai"],
      detail: !r
        ? "Belum dianalisis."
        : plat.length === 0
          ? "Modul berjalan, <b>nol pembacaan</b>. Pada sumber 640×360 pelat "
            + "hanya selebar 8–15 piksel, di bawah ambang OCR."
          : `Modul menghasilkan <b>${plat.length} pembacaan</b>, `
            + `<b>${sah.length} yang berpola pelat Indonesia</b>: `
            + plat.map((x) => `<code>${esc(x.text)}</code>`).join(" ")
            + ". Sisanya sampah OCR akibat resolusi sumber."
    });

    // 2. Atribut kendaraan
    const attr = (r?.attributes || []);
    const warna = attr.filter((a) => a.label.startsWith("Color"));
    const tipe = attr.filter((a) => a.label.startsWith("Type"));
    const ringkas = (arr) => arr.slice(0, 4)
      .map((a) => `<b>${esc(a.label.split(": ").pop())}</b> ${a.n}`).join(" · ");
    baris.push({
      no: "2", nama: "Atribut kendaraan",
      st: !r ? ["idle", "belum"] : attr.length ? ["ok", "aktif"] : ["bad", "nihil"],
      detail: !r ? "Belum dianalisis."
        : attr.length
          ? `${r.attr_samples} sampel. Warna: ${ringkas(warna) || "—"}. `
            + `Tipe: ${ringkas(tipe) || "—"}.`
          : "Modul aktif tetapi tidak menghasilkan label."
    });

    // 3. Hitung kendaraan
    const mode = r?.count_mode;
    baris.push({
      no: "3", nama: "Hitung kendaraan",
      st: !r ? ["idle", "belum"] : mode ? ["ok", "aktif"] : ["bad", "mati"],
      detail: !r ? "Belum dianalisis."
        : mode === "zona"
          ? `<b>${r.entrance_in}</b> kendaraan masuk zona. Mode zona dipakai `
            + "karena parkir liar menuntut region_type custom - hitung "
            + "garis-lintas (masuk/keluar) tidak bisa aktif bersamaan."
          : mode === "garis"
            ? `<b>${r.entrance_in}</b> masuk, <b>${r.entrance_out}</b> keluar `
              + "melintasi garis."
            : "Mode hitung tidak aktif pada skenario ini."
    });

    // 4. Parkir liar
    const ev = (r?.events || []);
    baris.push({
      no: "4", nama: "Deteksi parkir liar",
      st: !r ? ["idle", "belum"] : ev.length ? ["bad", `${ev.length} kejadian`] : ["ok", "nihil"],
      detail: !r ? "Belum dianalisis."
        : ev.length
          ? ev.map((e) => `Objek #${e.track_id} diam <b>${e.duration_sec} dtk</b>`).join(" · ")
          : `Tidak ada kendaraan diam melewati ambang <b>`
            + `${b?.illegal_parking_time ?? "?"} dtk</b> di zona ini.`
    });

    $("toolbox").innerHTML = baris.map((x) => `
      <div class="row">
        <span class="no">${x.no}</span>
        <span class="nm">${esc(x.nama)}</span>
        <span class="st ${x.st[0]}">${esc(x.st[1])}</span>
        <span class="dt">${x.detail}</span>
      </div>`).join("");
  }

  function renderChart() {
    const series = statsReal()
      ? stats.hourly.map((h) => [h.hour, h.count])
      : HOURLY;
    const max = Math.max(1, ...series.map((h) => h[1]));
    const W = 320, H = 84, base = 66, bw = W / series.length;
    const bars = series.map(([hr, v], i) => {
      const h = (v / max) * 52;
      const x = i * bw + 2, y = base - h;
      const peak = v === max && v > 0;
      return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${(bw - 4).toFixed(1)}"` +
        ` height="${h.toFixed(1)}" rx="1.5"` +
        ` fill="${peak ? "var(--crit)" : "var(--accent)"}"` +
        ` fill-opacity="${peak ? "1" : ".55"}"/>` +
        (peak ? `<text x="${(x + (bw - 4) / 2).toFixed(1)}" y="${(y - 4).toFixed(1)}"` +
          ` text-anchor="middle" fill="var(--crit)" font-family="IBM Plex Mono, monospace"` +
          ` font-size="10" font-weight="600">${v}</text>` : "") +
        (hr % 3 === 0 ? `<text x="${(x + (bw - 4) / 2).toFixed(1)}" y="80"` +
          ` text-anchor="middle" fill="var(--muted)"` +
          ` font-family="IBM Plex Mono, monospace" font-size="9">${hr}</text>` : "");
    }).join("");
    // An all-zero chart with a bare axis reads as broken rather than as "no
    // violations yet", so say so in words.
    const empty = series.every(([, v]) => v === 0);
    const note = empty
      ? `<text x="${W / 2}" y="40" text-anchor="middle" fill="var(--muted)"` +
        ` font-family="IBM Plex Sans, sans-serif" font-size="11">` +
        `${statsReal() ? "Belum ada kejadian hari ini" : "Tidak ada data"}</text>`
      : "";
    $("chart").innerHTML =
      `<line x1="0" y1="${base + .5}" x2="${W}" y2="${base + .5}"` +
      ` stroke="var(--line)" stroke-width="1"/>${bars}${note}`;
  }

  // ------------------------------------------------------------- modal
  let eventAktif = null;

  function openEvent(i) {
    const e = FEED[i], cam = camOf(e);
    eventAktif = e;
    const badBox = (cam.boxes || []).find((b) => b.bad) || (cam.boxes || [])[0];
    $("dKind").textContent = e.kind;
    // Tanggal diambil dari kejadiannya, tidak lagi ditanam di kode.
    $("dWhere").textContent =
      `${cam.name} · ${cam.area} · ${e.iso ? tanggalJamWIB(e.iso) : e.t + " WIB"}`;
    // Gambar yang tersimpan adalah frame pemeriksaan TERAKHIR kamera itu.
    // Untuk temuan dari siklus sebelumnya, gambar ini bukan momen kejadiannya
    // - dan itu harus dikatakan, bukan dibiarkan terbaca sebagai bukti.
    const rec = camBatch(cam)?.record;
    const sesuaiSiklus = (e.cycleId != null && rec?.cycle_id != null)
      ? rec.cycle_id === e.cycleId
      : rec?.finished_at === e.iso;
    $("dImg").src = e.real && CAMS[e.cam] != null && hasAnalysis(cam)
      ? `/api/batch/frame/${encodeURIComponent(cam.key)}`
      : cam.img;
    $("dImg").alt = `Bukti kejadian di ${cam.name}`;
    $("dOverlay").innerHTML = e.real ? ""
      : overlaySvg(cam, badBox ? badBox.id : null, true);
    $("dFacts").innerHTML = [
      ["Kamera", `<span class="mono">${esc(cam.id)}</span>`],
      ["Operator", esc(cam.owner)],
      ["Kendaraan", esc(e.kendaraan)],
      ["Durasi", esc(e.durasi)],
      ["Pelat nomor", e.plat
        ? `<span class="mono">${esc(e.plat)}</span>`
        : '<span style="color:var(--crit)">Tidak terbaca — resolusi sumber 360p</span>'],
      ["Keyakinan", e.conf != null
        ? `<span class="mono">${Math.round(e.conf * 100)}%</span>`
        : '<span style="color:var(--muted)">— (aturan zona, bukan skor)</span>'],
      ["Kewenangan", e.wewenang === "dishub"
        ? '<strong style="color:var(--crit)">Dishub DKI Jakarta</strong>'
        : '<strong style="color:var(--info)">Ditlantas Polda Metro Jaya</strong>'],
      ["Status", e.verified
        ? `<strong style="color:var(--ok)">Sudah diverifikasi petugas</strong>`
          + (e.verdict ? ` \u2014 ${esc(e.verdict === "bukan"
              ? "dinyatakan bukan pelanggaran" : "dinyatakan benar")}` : "")
        : "Menunggu verifikasi"],
      ["Gambar", e.real && !sesuaiSiklus
        ? '<span style="color:var(--warn)">Frame pemeriksaan terbaru kamera ini, '
          + 'bukan momen kejadian \u2014 siklus saat temuan ini tercatat sudah '
          + 'terlewat</span>'
        : "Frame dari siklus saat temuan ini tercatat"],
    ].map(([k, v]) => `<dt>${esc(k)}</dt><dd>${v}</dd>`).join("");
    $("dLegal").textContent = e.legal;
    // Tombol membawa putusannya sendiri: dua tindakan pertama menegaskan
    // temuan, yang terakhir menolaknya. Keduanya tersimpan ke basis data,
    // karena kartu "Diverifikasi petugas" membaca dari sana.
    const tindakan = e.wewenang === "dishub"
      ? [["Terbitkan perintah derek", "benar"], ["Kirim petugas", "benar"],
         ["Bukan pelanggaran", "bukan"]]
      : [["Teruskan ke Ditlantas", "benar"], ["Bukan pelanggaran", "bukan"]];
    $("dActions").innerHTML = e.verified
      ? '<button type="button" class="ghost" data-verdict="">Tutup</button>'
      : tindakan.map(([t, v], j) =>
          `<button type="button" class="${j === 0 ? "primary" : "ghost"}"`
          + ` data-verdict="${v}">${esc(t)}</button>`).join("");
    $("detail").showModal();
  }

  // ------------------------------------------------------------- wiring
  $("cams").addEventListener("click", (ev) => {
    const el = ev.target.closest(".cam");
    if (!el) return;
    active = Number(el.dataset.i);
    renderStage();
  });

  $("feed").addEventListener("click", (ev) => {
    const el = ev.target.closest(".ev");
    if (el) openEvent(Number(el.dataset.e));
  });

  document.querySelector(".toolbar").addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-layer]");
    if (!b || b.disabled) return;
    const key = b.dataset.layer;
    layers[key] = !layers[key];
    b.setAttribute("aria-pressed", String(layers[key]));
    renderStage();
  });

  function syncSumber() {
    document.querySelectorAll("[data-src]").forEach((el) =>
      el.setAttribute("aria-pressed", String(el.dataset.src === srcMode)));
  }

  document.querySelector(".toolbar").addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-src]");
    if (!b) return;
    srcMode = b.dataset.src;
    document.querySelectorAll("[data-src]").forEach((el) =>
      el.setAttribute("aria-pressed", String(el.dataset.src === srcMode)));
    clearInterval(liveTimer);
    liveWorking = null;
    liveFails = 0;
    setLiveChip();
    renderStage();
    renderFeed();
  });

  // ---------------------------------------------------------- penuntun
  // Urutannya mengikuti alur kerja nyata: pilih kamera dulu, baru lihat
  // gambarnya, baru baca hasilnya. Bukan urutan tata letak di layar.
  const TOUR = [
    { sel: "#proto", judul: "Penanda kejujuran",
      teks: "Mulailah dari sini setiap kali membuka. Hijau berarti seluruh angka "
          + "di layar berasal dari pembacaan mesin. Bila kuning, ia menyebutkan "
          + "bagian mana yang masih berupa contoh - jangan pakai bagian itu untuk "
          + "mengambil keputusan." },
    { sel: ".cams", judul: "Pilih kameranya",
      teks: "Kamera dikelompokkan per wilayah DKI. Titik merah menandai kamera "
          + "yang punya temuan perlu ditindak. Angka skor di bawah nama menunjukkan "
          + "seberapa besar kendaraan tampak - makin tinggi, makin andal bacaannya. "
          + "Wilayah bernilai nol berarti memang tidak ada kamera publik di sana." },
    { sel: ".viewport", judul: "Panggung gambar",
      teks: "Isi panel ini mengikuti sumber yang dipilih di bawahnya. Semua "
          + "penilaian Anda bertumpu pada gambar ini, jadi pastikan Anda tahu "
          + "gambar apa yang sedang dilihat - itu gunanya keterangan di langkah "
          + "berikutnya." },
    { sel: ".stamp", judul: "Keterangan pada gambar",
      teks: "Pojok kiri bawah selalu menyebutkan nomor kamera, namanya, dan waktu. "
          + "Pada mode Analisis, waktu ini adalah waktu PEMERIKSAAN, bukan waktu "
          + "sekarang. Biasakan membacanya sebelum menyimpulkan apa pun." },
    { sel: "#grpSumber", judul: "Tiga sumber gambar",
      teks: "Live menampilkan kondisi jalan sekarang, disegarkan tiap 3 detik, "
          + "tanpa kotak deteksi. Analisis menampilkan hasil kerja mesin - inilah "
          + "mode yang Anda pakai saat bertugas. Cuplikan adalah gambar tersimpan, "
          + "untuk keadaan jaringan ke server CCTV terputus." },
    { sel: "#grpLapisan", judul: "Empat lapisan tampilan",
      teks: "Zona menampilkan area yang diawasi. Objek menampilkan kotak "
          + "kendaraan - tipis untuk kendaraan biasa, merah tebal untuk yang "
          + "melanggar. Lintasan menampilkan jejak gerak beberapa detik "
          + "terakhir. Samarkan pelat menutup bagian pelat demi perlindungan "
          + "data pribadi. Keempatnya bisa dimatikan bila gambar terasa "
          + "terlalu ramai." },
    { sel: "#hint", judul: "Baris keterangan",
      teks: "Baris ini berubah mengikuti mode yang dipilih dan menjelaskan apa "
          + "yang sedang Anda lihat. Ia juga memperingatkan bila zona baru saja "
          + "diubah tetapi belum dipakai pemeriksaan." },
    { sel: "#reanalyse", judul: "Memeriksa ulang",
      teks: "Mode Analisis menampilkan pemeriksaan terakhir, bukan detik ini. "
          + "Tombol ini memeriksa ulang kamera yang sedang dibuka - sekitar 40 "
          + "sampai 60 detik. Layar akan berpindah sendiri ke mode Analisis "
          + "setelah selesai.",
      aksi: () => { srcMode = "analisis"; syncSumber(); renderStage(); } },
    { sel: "#readout", judul: "Empat angka ringkas",
      teks: "Track unik adalah jumlah objek berbeda yang terlacak. Frame "
          + "dianalisis menunjukkan berapa gambar diperiksa. Kejadian adalah "
          + "jumlah pelanggaran yang ditemukan. Waktu proses adalah lama "
          + "pemeriksaan. Tanda strip berarti kamera itu belum pernah diperiksa." },
    { sel: "#toolbox", judul: "Empat kemampuan mesin",
      teks: "Tiap baris menampilkan statusnya sendiri: aktif, nihil, atau tidak "
          + "memadai. Di kanan atas panel tertera nama zona yang sedang berlaku. "
          + "Perhatikan baris pertama - pada CCTV publik, pengenalan pelat selalu "
          + "bertanda tidak memadai, dan keluarannya tidak boleh dipakai." },
    { sel: "#panelKualitas", judul: "Kualitas siaran kamera",
      teks: "Panel ini menilai seberapa layak siaran kamera untuk tiap jenis "
          + "pembacaan, lengkap dengan spesifikasi teknisnya. Baris merah bukan "
          + "kerusakan sistem - itu batas yang ditentukan resolusi sumber, dan "
          + "keterangan di bawahnya menjelaskan apa yang diperlukan untuk "
          + "mengatasinya." },
    { sel: "#feed", judul: "Daftar temuan",
      teks: "Setiap baris adalah usulan mesin, bukan penetapan pelanggaran. "
          + "Labelnya menyebutkan kewenangan: ranah Dishub berarti dapat ditindak "
          + "sendiri secara administratif, rujuk Ditlantas berarti tilang yang "
          + "merupakan kewenangan Kepolisian. Waktunya dalam WIB." },
    { sel: "#detail", judul: "Kartu bukti",
      teks: "Klik satu baris temuan untuk membuka kartu ini. Isinya gambar "
          + "berkotak, identitas kamera, durasi, status pelat, kewenangan, dan "
          + "dasar hukumnya. Periksa gambarnya sendiri sebelum menindak - mesin "
          + "pernah menandai drum kabel di trotoar sebagai kendaraan. Tombol di "
          + "bawah kartu untuk memutuskan tindakan.",
      aksi: () => { const e = document.querySelector("#feed .ev"); if (e) e.click(); },
      tutup: () => $("detail").close() },
    { sel: ".kpis", judul: "Rekap hari berjalan",
      teks: "Ketiga kartu ini bisa diklik. Kejadian hari ini menyaring daftar "
          + "temuan di sebelah kanan - klik tulisan ranah Dishub atau dirujuk "
          + "untuk menyaring per kewenangan. Diverifikasi petugas membuka "
          + "antrean yang belum ditindak. Kendaraan terpantau membuka rincian "
          + "per kamera. Semuanya dihitung dalam waktu WIB; periksa kartu "
          + "Diverifikasi petugas di akhir giliran tugas." },
    { sel: "#theme", judul: "Mode gelap",
      teks: "Mengubah tampilan terang atau gelap. Untuk peragaan lewat proyektor, "
          + "mode gelap biasanya lebih terbaca. Pilihan ini tersimpan di peramban "
          + "masing-masing." },
    { sel: "#helpBtn", judul: "Membuka panduan kembali",
      teks: "Penuntun ini dapat dijalankan ulang kapan saja lewat tombol Bantuan, "
          + "yang juga memuat panduan lengkap dalam bentuk bacaan. Selesai - "
          + "silakan mulai dengan memilih kamera di sisi kiri." },
  ];

  let tourI = -1;

  function tourTutup() {
    if (tourI >= 0 && TOUR[tourI] && TOUR[tourI].tutup) {
      try { TOUR[tourI].tutup(); } catch (_) {}
    }
    tourI = -1;
    document.querySelector(".tour-hole")?.remove();
    document.querySelector(".tour-card")?.remove();
    window.removeEventListener("resize", tourGambar);
  }

  function tourGambar() {
    if (tourI < 0 || tourI >= TOUR.length) return;
    const t = TOUR[tourI];
    const el = document.querySelector(t.sel);
    if (!el) { tourLangkah(tourI + 1); return; }

    const r = el.getBoundingClientRect();
    const pad = 6;
    let hole = document.querySelector(".tour-hole");
    if (!hole) {
      hole = document.createElement("div");
      hole.className = "tour-hole";
      document.body.appendChild(hole);
    }
    hole.style.top = (r.top - pad) + "px";
    hole.style.left = (r.left - pad) + "px";
    hole.style.width = (r.width + pad * 2) + "px";
    hole.style.height = (r.height + pad * 2) + "px";

    let card = document.querySelector(".tour-card");
    if (!card) {
      card = document.createElement("div");
      card.className = "tour-card";
      document.body.appendChild(card);
    }
    const akhir = tourI === TOUR.length - 1;
    card.innerHTML =
      '<div class="no">Langkah ' + (tourI + 1) + ' dari ' + TOUR.length + '</div>' +
      '<h3>' + esc(t.judul) + '</h3><p>' + esc(t.teks) + '</p>' +
      '<div class="tour-nav">' +
      '<button class="icon" data-t="prev"' + (tourI ? '' : ' disabled') + '>Kembali</button>' +
      '<button class="icon" data-t="next" style="background:var(--accent);' +
      'border-color:var(--accent);color:var(--panel);font-weight:600">' +
      (akhir ? 'Selesai' : 'Lanjut') + '</button>' +
      '<span class="sp"></span>' +
      '<button class="icon" data-t="skip">Lewati</button></div>';

    // Kartu ditaruh di bawah sorotan bila muat, kalau tidak di atasnya.
    const ch = card.offsetHeight || 170, cw = card.offsetWidth || 350;
    const bawah = r.bottom + 14 + ch < window.innerHeight;
    card.style.top = (bawah ? r.bottom + 12 : Math.max(10, r.top - ch - 12)) + "px";
    card.style.left = Math.min(Math.max(10, r.left), window.innerWidth - cw - 10) + "px";
  }

  function tourLangkah(i) {
    // Bersihkan dulu keadaan yang disiapkan langkah sebelumnya - misalnya
    // kartu bukti yang dibuka agar bisa disorot.
    if (tourI >= 0 && TOUR[tourI] && TOUR[tourI].tutup) {
      try { TOUR[tourI].tutup(); } catch (_) {}
    }
    if (i >= TOUR.length || i < 0) { tourTutup(); return; }
    tourI = i;
    // Sebagian langkah perlu menyetel layar lebih dulu: menjelaskan mode
    // Analisis sementara layar menampilkan Live hanya membuat bingung.
    if (TOUR[i].aksi) { try { TOUR[i].aksi(); } catch (_) {} }
    const el = document.querySelector(TOUR[i].sel);
    if (!el) { tourLangkah(i + 1); return; }
    el.scrollIntoView({ block: "center", behavior: "smooth" });
    setTimeout(tourGambar, 420);
  }

  function tourMulai() {
    $("bantuan").close();
    window.addEventListener("resize", tourGambar);
    tourLangkah(0);
  }

  document.addEventListener("click", (ev) => {
    const b = ev.target.closest(".tour-card [data-t]");
    if (!b) return;
    if (b.dataset.t === "next") tourLangkah(tourI + 1);
    else if (b.dataset.t === "prev") tourLangkah(tourI - 1);
    else tourTutup();
  });
  document.addEventListener("keydown", (ev) => {
    if (tourI < 0) return;
    if (ev.key === "Escape") tourTutup();
    if (ev.key === "ArrowRight") tourLangkah(tourI + 1);
    if (ev.key === "ArrowLeft") tourLangkah(tourI - 1);
  });

  // ------------------------------------------------- drill-down kartu KPI
  // Umpan balik uji pengguna: angkanya terbaca, tetapi tidak ada jalan dari
  // angka ke temuan yang membentuknya.
  $("kpi1").addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-drill]");
    setFilter(b ? b.dataset.drill : null);
  });
  $("kpi2").addEventListener("click", () => setFilter("belum"));
  $("kpi3").addEventListener("click", bukaRincian);
  for (const id of ["kpi1", "kpi2", "kpi3"]) {
    $(id).addEventListener("keydown", (ev) => {
      if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); $(id).click(); }
    });
  }
  $("filterChip").addEventListener("click", () => setFilter(feedFilter));
  $("rClose").addEventListener("click", () => $("rincian").close());

  async function bukaRincian() {
    $("rBody").innerHTML = '<p style="color:var(--muted);font-size:12.5px">Memuat…</p>';
    $("rincian").showModal();
    let baris;
    try { baris = await api("/api/stats/cameras"); }
    catch { $("rBody").innerHTML = '<p style="color:var(--crit);font-size:12.5px">'
      + 'Rincian tidak tersedia — backend tidak terjangkau.</p>'; return; }
    if (!baris.length) {
      $("rBody").innerHTML = '<p style="color:var(--muted);font-size:12.5px">'
        + 'Belum ada siklus analisis hari ini.</p>'; return;
    }
    const nama = (k) => (CAMS.find((c) => c.key === k) || {}).name || k;
    const jum = baris.reduce((a, r) => ({
      cycles: a.cycles + r.cycles, tracks: a.tracks + r.tracks,
      events: a.events + r.events,
    }), { cycles: 0, tracks: 0, events: 0 });
    $("rBody").innerHTML =
      '<table style="width:100%;border-collapse:collapse;font-size:12.5px">'
      + '<thead><tr>' + ["Kamera", "Siklus", "Track", "Frame", "Temuan", "Terakhir"]
        .map((h, i) => `<th style="text-align:${i ? "right" : "left"};padding:6px 8px;`
          + `border-bottom:1px solid var(--line);color:var(--muted);font-size:10.5px;`
          + `text-transform:uppercase;letter-spacing:.06em">${h}</th>`).join("")
      + '</tr></thead><tbody>'
      + baris.map((r) => `<tr>
          <td style="padding:6px 8px;border-bottom:1px solid var(--line-soft)">
            ${esc(nama(r.camera))}${r.ok_cycles < r.cycles
              ? ` <span style="color:var(--crit)">${r.cycles - r.ok_cycles} gagal</span>` : ""}</td>
          <td style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line-soft);font-family:var(--mono)">${r.cycles}</td>
          <td style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line-soft);font-family:var(--mono)">${r.tracks.toLocaleString("id-ID")}</td>
          <td style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line-soft);font-family:var(--mono)">${r.frames.toLocaleString("id-ID")}</td>
          <td style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line-soft);font-family:var(--mono)">${r.events}</td>
          <td style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line-soft);font-family:var(--mono)">${esc(jamWIB(r.last_at))}</td>
        </tr>`).join("")
      + `<tr><td style="padding:7px 8px;font-weight:700">Jumlah</td>
          <td style="text-align:right;padding:7px 8px;font-family:var(--mono);font-weight:700">${jum.cycles}</td>
          <td style="text-align:right;padding:7px 8px;font-family:var(--mono);font-weight:700">${jum.tracks.toLocaleString("id-ID")}</td>
          <td></td>
          <td style="text-align:right;padding:7px 8px;font-family:var(--mono);font-weight:700">${jum.events}</td>
          <td></td></tr>`
      + '</tbody></table>';
  }

  $("tourBtn").addEventListener("click", tourMulai);
  $("helpBtn").addEventListener("click", () => $("bantuan").showModal());
  $("helpClose").addEventListener("click", () => $("bantuan").close());
  // Dibuka sendiri pada kunjungan pertama: operator baru tidak tahu ada
  // tombol bantuan sampai ia butuh, dan saat itu biasanya sudah salah klik.
  try {
    if (!localStorage.getItem("rkl-help-seen")) {
      localStorage.setItem("rkl-help-seen", "1");
      setTimeout(tourMulai, 1200);   // tunggu data pertama masuk
    }
  } catch (_) {}

  $("dClose").addEventListener("click", () => $("detail").close());
  $("dActions").addEventListener("click", async (ev) => {
    const b = ev.target.closest("button");
    if (!b) return;
    const verdict = b.dataset.verdict;
    $("detail").close();
    if (!verdict || !eventAktif?.id) return;
    try {
      await api(`/api/events/${eventAktif.id}/verify?verdict=${verdict}`,
                { method: "POST" });
      await refreshBatch();          // kartu KPI dan daftar ikut bergerak
    } catch (err) {
      alert("Gagal menyimpan verifikasi: " + err.message);
    }
  });

  // Theme toggle: the viewer's own theme wins until they press this.
  const themeBtn = $("theme");
  themeBtn.addEventListener("click", () => {
    const dark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    themeBtn.textContent = dark ? "Mode gelap" : "Mode terang";
    try { localStorage.setItem("rkl-theme", dark ? "light" : "dark"); } catch (_) {}
  });
  try {
    const saved = localStorage.getItem("rkl-theme");
    if (saved) {
      document.documentElement.setAttribute("data-theme", saved);
      themeBtn.textContent = saved === "dark" ? "Mode terang" : "Mode gelap";
    }
  } catch (_) {}

  const clock = () => {
    const d = new Date();
    $("clock").textContent = d.toLocaleTimeString("id-ID", { hour12: false }) + " WIB";
  };
  clock();
  setInterval(clock, 1000);

  async function refreshBatch() {
    try {
      batch = await api("/api/batch");
      stats = await api("/api/stats");
      EVDB = await api("/api/events?limit=100");
    } catch {
      // no backend (a published artifact): stay on snapshots and demo figures
      batch = null;
      stats = null;
      EVDB = [];
    }
    $("reanalyse").disabled = !batch;
    renderStage();
    renderFeed();
    renderToolbox();
    renderKpi();
    renderChart();
  }

  $("reanalyse").addEventListener("click", async () => {
    const btn = $("reanalyse");
    const cam = CAMS[active];
    const sebelum = camBatch(cam)?.record?.finished_at || "";
    btn.disabled = true;
    btn.textContent = "Menganalisis…";
    try {
      await api(`/api/batch/run?key=${encodeURIComponent(cam.key)}&background=true`,
                { method: "POST" });
    } catch (e) {
      btn.disabled = false;
      btn.textContent = "Analisis kamera ini";
      return;
    }
    // Tunggu sampai stempel waktu kamera INI berubah, bukan sekadar menunggu
    // beberapa detik: durasi analisis berbeda-beda per kamera.
    const mulai = Date.now();
    const cek = setInterval(async () => {
      await refreshBatch();
      const kini = camBatch(cam)?.record?.finished_at || "";
      if (kini && kini !== sebelum) {
        clearInterval(cek);
        btn.disabled = false;
        btn.textContent = "Analisis kamera ini";
        srcMode = "analisis";
        document.querySelectorAll("[data-src]").forEach((el) =>
          el.setAttribute("aria-pressed", String(el.dataset.src === srcMode)));
        renderStage();
      } else if (Date.now() - mulai > 300000) {
        clearInterval(cek);
        btn.disabled = false;
        btn.textContent = "Analisis kamera ini";
      }
    }, 5000);
  });

  setLiveChip();
  renderCams();
  renderStage();
  renderGrades();
  renderFeed();
  renderKpi();
  renderChart();
  refreshBatch();
  setInterval(refreshBatch, 20000);
})();
</script>
